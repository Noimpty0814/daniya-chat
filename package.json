{
  "name": "daniya-chat",
  "version": "0.1.0",
  "private": true,
  "description": "达妮娅聊天 - 接入 DeepSeek 的桌宠聊天软件",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "npm run prepare:harness && npm run build && electron-builder --win",
    "prepare:harness": "node scripts/prepare-harness.mjs",
    "test": "vitest run",
    "gen-icon": "node scripts/gen-icon.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dev:harness": "node harness/setup-dev-home.mjs && node harness/launch.mjs"
  },
  "build": {
    "appId": "com.daniya.chat",
    "productName": "达妮娅聊天",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pet-helper.ps1",
        "to": "pet-helper.ps1"
      },
      {
        "from": "build/harness-bundle",
        "to": "harness"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "达妮娅聊天"
    }
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
